DATABASE_URL="mongodb+srv://YOUR_MONGODB_CONNECTION"
JWT_SECRET="replace_with_a_long_random_secret"

# Supabase (required for auth + LMS platform)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Legacy API base, only needed if you still use the API app alongside the Supabase web flow
NEXT_PUBLIC_API_BASE=http://localhost:4100
